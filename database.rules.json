{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": "auth != null",
      ".indexOn": [
        "best",
        "bestSp"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "best": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "losses": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "draws": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "bestSp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999"
        },
        "winsSp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "lossesSp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "drawsSp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (data.exists() && !data.child('guest').exists() && newData.child('guest').val() === auth.uid))",
        ".validate": "$code.length === 5",
        "players": {
          "$uid": {
            ".validate": "data.exists() || $uid === auth.uid",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "board": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            }
          }
        },
        "attacks": {
          "$id": {
            ".validate": "newData.hasChildren(['from', 'n']) && newData.child('from').val() === auth.uid && newData.child('n').isNumber() && newData.child('n').val() >= 1 && newData.child('n').val() <= 12"
          }
        },
        "host": {
          ".validate": "newData.isString()"
        },
        "guest": {
          ".validate": "newData.isString() && newData.val() !== newData.parent().child('host').val()"
        },
        "special": {
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}